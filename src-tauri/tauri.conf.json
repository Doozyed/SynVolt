{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SynVolt",
  "version": "0.1.33",
  "identifier": "com.synvolt.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SynVolt",
        "width": 1339,
        "height": 828,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "template": "installer.nsi",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/synz.ico"
    ],
    "externalBin": [
      "binaries/luau-lsp"
    ],
    "resources": {
      "resources/SynInstallerV2.exe": "synz/SynInstallerV2.exe"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0QjQxRDg5RTNEREQ1NzUKUldSMTFkM2ppUjIwcEhIVzhZRXFTMGVXNGtNY2dkaG5weW83QnRXOUdKd2haaEFEd0VjLzErNTAK",
      "endpoints": [
        "https://synvolt-updates.xanderbear2019.workers.dev/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
